{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Studiograph",
  "colors": {
    "primary": "#6e6ee8",
    "light": "#8b8bf0",
    "dark": "#5c5cd6"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guide",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "getting-started/your-account",
              "getting-started/tour"
            ]
          },
          {
            "group": "Your workspace",
            "pages": [
              "workspace/folders",
              "workspace/sharing",
              "workspace/entries",
              "workspace/views",
              "workspace/connections",
              "workspace/collaboration"
            ]
          },
          {
            "group": "Your library",
            "pages": [
              "library/overview",
              "library/importing-files",
              "library/media-in-your-work"
            ]
          },
          {
            "group": "Artifacts & datasets",
            "pages": [
              "artifacts/overview",
              "artifacts/datasets",
              "artifacts/live-data"
            ]
          },
          {
            "group": "The AI agent",
            "pages": [
              "agent/chat",
              "agent/context-and-attachments",
              "agent/skills",
              "agent/connectors"
            ]
          },
          {
            "group": "Settings",
            "pages": [
              "settings/overview",
              "settings/entry-types"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "CLI",
            "pages": [
              "cli/overview",
              "cli/commands",
              "cli/sync",
              "cli/mcp"
            ]
          }
        ]
      },
      {
        "tab": "Self-hosting",
        "groups": [
          {
            "group": "Self-hosting",
            "pages": [
              "self-hosting/overview",
              "self-hosting/docker",
              "self-hosting/railway",
              "self-hosting/providers",
              "self-hosting/configuration",
              "self-hosting/storage-and-backups"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/studiographai",
          "icon": "github"
        }
      ]
    }
  },
  "redirects": [
    { "source": "/quickstart", "destination": "/getting-started/your-account" },
    { "source": "/concepts/knowledge-graph", "destination": "/workspace/connections" },
    { "source": "/concepts/workspaces", "destination": "/getting-started/tour" },
    { "source": "/concepts/folders", "destination": "/workspace/folders" },
    { "source": "/concepts/entities", "destination": "/workspace/entries" },
    { "source": "/concepts/access", "destination": "/workspace/sharing" },
    { "source": "/cli/installation", "destination": "/cli/overview" },
    { "source": "/cli/deployment", "destination": "/self-hosting/overview" },
    { "source": "/api-reference/introduction", "destination": "/cli/mcp" }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "href": "https://x.com/studiographai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/getting-started/your-account"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/studiographai",
      "linkedin": "https://linkedin.com/company/studiographai"
    }
  }
}
