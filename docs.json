{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Studiograph",
  "colors": {
    "primary": "#6e6ee8",
    "light": "#8b8bf0",
    "dark": "#5c5cd6"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/knowledge-graph",
              "concepts/workspaces",
              "concepts/folders",
              "concepts/entities",
              "concepts/access"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "groups": [
          {
            "group": "CLI reference",
            "pages": [
              "cli/overview",
              "cli/installation",
              "cli/commands"
            ]
          },
          {
            "group": "Workflows",
            "pages": [
              "cli/sync",
              "cli/mcp",
              "cli/deployment"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/studiographai",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "href": "https://x.com/studiographai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "/quickstart"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/studiographai",
      "linkedin": "https://linkedin.com/company/studiographai"
    }
  }
}
