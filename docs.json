{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Studiograph",
  "colors": {
    "primary": "#6e6ee8",
    "light": "#8b8bf0",
    "dark": "#5c5cd6"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "getting-started/your-account",
          "getting-started/tour"
        ]
      },
      {
        "group": "Your workspace",
        "pages": [
          "workspace/folders",
          "workspace/sharing",
          "workspace/entries",
          "workspace/views",
          "workspace/connections",
          "workspace/collaboration"
        ]
      },
      {
        "group": "Your library",
        "pages": [
          "library/overview",
          "library/importing-files",
          "library/media-in-your-work"
        ]
      },
      {
        "group": "Artifacts & datasets",
        "pages": [
          "artifacts/overview",
          "artifacts/datasets",
          "artifacts/live-data"
        ]
      },
      {
        "group": "The AI agent",
        "pages": [
          "agent/chat",
          "agent/context-and-attachments",
          "agent/skills",
          "agent/connectors"
        ]
      },
      {
        "group": "Connect AI tools",
        "pages": [
          "ai-tools/mcp"
        ]
      },
      {
        "group": "Settings",
        "pages": [
          "settings/overview",
          "settings/ai-plan",
          "settings/entry-types"
        ]
      }
    ]
  },
  "redirects": [
    { "source": "/quickstart", "destination": "/getting-started/your-account" },
    { "source": "/concepts/knowledge-graph", "destination": "/workspace/connections" },
    { "source": "/concepts/workspaces", "destination": "/getting-started/tour" },
    { "source": "/concepts/folders", "destination": "/workspace/folders" },
    { "source": "/concepts/entities", "destination": "/workspace/entries" },
    { "source": "/concepts/access", "destination": "/workspace/sharing" },
    { "source": "/cli/installation", "destination": "/" },
    { "source": "/cli/deployment", "destination": "/" },
    { "source": "/api-reference/introduction", "destination": "/ai-tools/mcp" },
    { "source": "/cli/mcp", "destination": "/ai-tools/mcp" },
    { "source": "/self-hosting/providers", "destination": "/settings/ai-plan" },
    { "source": "/cli/:slug*", "destination": "/" },
    { "source": "/self-hosting/:slug*", "destination": "/" }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "href": "https://x.com/studiographai"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "/getting-started/your-account"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/studiographai",
      "linkedin": "https://linkedin.com/company/studiographai"
    }
  }
}
